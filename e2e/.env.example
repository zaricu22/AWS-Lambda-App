# Copy to .env and fill in the demo user created via:
#   aws cognito-idp admin-create-user / admin-set-user-password
# (see root README "Create a demo user")
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=YourPassword123!

# Override to point at a deployed CloudFront URL instead of local dev.
# BASE_URL=https://<your-cloudfront-domain>
